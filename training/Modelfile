# Load the LoRA-fine-tuned HybridScope model (made with finetune_lora.py on Colab) into Ollama:
#   ollama create hybridscope -f Modelfile
# Change the file name below if your GGUF file is called differently.
FROM ./hybridscope-gguf/model-unsloth.Q4_K_M.gguf

TEMPLATE """{{- range $i, $_ := .Messages }}
{{- $last := eq (len (slice $.Messages $i)) 1 }}
{{- if or (eq .Role "user") (eq .Role "system") }}<start_of_turn>user
{{ .Content }}<end_of_turn>
{{ if $last }}<start_of_turn>model
{{ end }}
{{- else if eq .Role "assistant" }}<start_of_turn>model
{{ .Content }}{{ if not $last }}<end_of_turn>
{{ end }}
{{- end }}
{{- end }}"""

PARAMETER stop "<end_of_turn>"
PARAMETER temperature 0
PARAMETER num_ctx 8192
