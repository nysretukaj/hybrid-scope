# Copy this file to backend/.env (git-ignored) and fill in what you use.

# --- LLM analysis (free) ---------------------------------------------------
# Groq: create a key at https://console.groq.com/keys (starts with gsk_)
# Gemini: https://aistudio.google.com/apikey (starts with AIza)
# The provider and model are detected automatically from the key.
LLM_API_KEY=

# Optional overrides
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. local Ollama (no key needed)
# LLM_MODEL=                                 # model for "Analyze Text"
# LLM_MODEL_LIVE=                            # faster model for live signals
# LLM_FOR_LIVE=1                             # upgrade live signals with the LLM in the background
# LLM_MAX_PER_INGEST=60
# LLM_RPM=20

# --- Push notifications (optional) ------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_WEBHOOK_URL=
# NOTIFY_MIN_LEVEL=CRITICAL
# PUBLIC_URL=http://localhost:8000
