# Copy this file to backend/.env (git-ignored) and fill in what you use.

# --- LLM analysis (free) ---------------------------------------------------
# Groq: create a key at https://console.groq.com/keys (starts with gsk_)
# Gemini: https://aistudio.google.com/apikey (starts with AIza)
# The provider and model are detected automatically from the key.
LLM_API_KEY=

# Optional overrides
# LLM_BASE_URL=http://localhost:11434/v1     # e.g. local Ollama (no key needed)
# LLM_MODEL=                                 # model for "Analyze Text"
# LLM_MODEL_LIVE=                            # faster model for live signals
# LLM_FOR_LIVE=1                             # upgrade live signals with the LLM in the background
# LLM_MAX_PER_INGEST=60
# LLM_RPM=20

# --- Local AI with Ollama (no key, no internet) -----------------------------
# Install Ollama (https://ollama.com), then once:  ollama pull gemma3:4b  and  ollama pull bge-m3
# OLLAMA_ENABLED=auto                        # auto | 1 | 0
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma3:4b                     # reads texts and pictures
# OLLAMA_EMBED_MODEL=bge-m3                  # multilingual text vectors for the trained model
# OLLAMA_CUSTOM_MODEL=hybridscope            # used automatically once created (AI model page)
# LOCAL_LLM_FOR_LIVE=0                       # 1 = label new live reports with the local LLM (slow on CPU)
# CLASSIFIER_MIN_PROB=0.7                    # the trained model never decides below this certainty
# CLASSIFIER_TARGET_PRECISION=0.9            # ...and only where its decisions were >= 90% correct
# IMAGE_MODEL_ENABLED=1                      # CLIP picture vectors in training (needs requirements-local-ai.txt)
# SERBIAN_LOCAL_AI_PER_INGEST=15             # Serbian reports read by the local AI per ingest (CPU: ~90 s each)

# --- Push notifications (optional) ------------------------------------------
# Telegram: token from @BotFather; then run `python -m app.notify --setup` to fill TELEGRAM_CHAT_ID
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_LANG=sq                                # language of the messages: sq, en or de
# ALERT_WEBHOOK_URL=
# NOTIFY_MIN_LEVEL=CRITICAL
# PUBLIC_URL=http://localhost:8000
